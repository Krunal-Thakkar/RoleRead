# OpenAI API key (required)
OPENAI_API_KEY=sk-...

# Where Chroma persists its data on disk
CHROMA_PERSIST_DIR=./chroma_data

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval
TOP_K=5

# Conversation memory
MAX_HISTORY_TURNS=6

# Models
# gpt-4o-mini is cost/latency-optimized default. Upgrade to gpt-4o (or newer) for better
# extraction robustness (messy PDF text) and more consistent holistic fit-score reasoning.
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
EXTRACTION_MODEL=gpt-4o-mini

# Minimum retrieval similarity (0-1, cosine) below which we refuse instead of calling the LLM
MIN_RETRIEVAL_SCORE=0.15

# Minimum embedding cosine similarity for a "possibly related" skill match (see gap_analysis.py).
# Calibrated against real text-embedding-3-small output on short skill-name phrases (0.75 was
# too strict; genuinely related short phrases often sit around 0.5-0.7 cosine similarity).
SEMANTIC_MATCH_THRESHOLD=0.60

# Max characters of a single document's raw text sent to the LLM for holistic questions
# (resume/JD are short enough that full text, not just retrieved chunks, is used — see chat.py)
MAX_CONTEXT_CHARS_PER_DOC=8000
